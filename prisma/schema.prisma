generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String? @unique
  name String @default("Гость")
  passwordHash String?
  role String @default("GUEST")
  origin String @default("USER")
  interests String[] @default([])
  createdAt DateTime @default(now())
  sessions Session[]
  attempts ProjectAttempt[]
  application Application?
  materials Material[]
  messages Message[]
  assessments Assessment[]
  decisions Decision[]
  scoringReviews ScoringReview[]
  twinReviews TwinReview[]
  profileAnswers ProfileAnswer[]
  developmentSteps DevelopmentStep[]
}
model Session {
  tokenHash String @id
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  expiresAt DateTime
  @@index([userId])
}
model Program {
  slug String @id
  title String
  shortTitle String
  description String
  disciplines String[]
  sourceUrl String
  checkedAt DateTime
  applications Application[]
}
model ProjectAttempt {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  slug String
  context String @default("WORKSHOP")
  startKey String? @unique
  parentVersionId String?
  parentVersion AttemptVersion? @relation("ContextSource", fields:[parentVersionId], references:[id], onDelete:Cascade)
  hintsUsed String[] @default([])
  configVersion Int @default(1)
  revision Int @default(0)
  state Json
  interest String @default("UNDECIDED")
  conditions String @default("Самостоятельная учебная работа, без ограничения времени")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions AttemptVersion[]
  transfers WorkTransfer[]
  @@index([userId,slug])
  @@unique([parentVersionId,context])
}
model AttemptVersion {
  id String @id @default(cuid())
  attemptId String
  attempt ProjectAttempt @relation(fields:[attemptId], references:[id], onDelete:Cascade)
  revision Int
  state Json
  feedback Json
  completed Boolean @default(false)
  ruleVersion Int @default(0)
  hintsUsed String[] @default([])
  saveKey String?
  basedOnRevision Int?
  followups ProjectAttempt[] @relation("ContextSource")
  createdAt DateTime @default(now())
  @@unique([attemptId,revision])
  @@unique([attemptId,saveKey])
}
model Application {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId],references:[id])
  programSlug String
  program Program @relation(fields:[programSlug],references:[slug])
  fields Json
  stage String @default("DRAFT")
  revision Int @default(0)
  origin String @default("USER")
  submittedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions ApplicationVersion[]
  materials Material[]
  sources Source[]
  episodes Episode[]
  assessments Assessment[]
  decisions Decision[]
  messages Message[]
  interviews Interview[]
  language LanguageCheck?
  transfers WorkTransfer[]
  audioConsent AudioConsent?
  audioConsentEvents AudioConsentEvent[]
  audioJobs AudioJob[]
  domainReviews DomainReview[]
  feedback FeedbackPublication[]
  scoringRuns ScoringRun[]
  scoringFixtures ScoringFixture[]
  twinAudits TwinAudit[]
  profileAnswers ProfileAnswer[]
}

model ProfileAnswer {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  applicationId String?
  application Application? @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  audience String
  scopeKey String
  requestKey String @unique
  request Json
  answer Json
  inputHash String
  provider String
  instructionVersion String
  createdAt DateTime @default(now())
  @@index([userId,scopeKey,createdAt])
}

model DevelopmentStep {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  key String
  recommendation Json
  note String @default("")
  selfCompletedAt DateTime?
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId,key])
}
model ApplicationVersion {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId],references:[id])
  revision Int
  snapshot Json
  kind String
  createdAt DateTime @default(now())
  @@unique([applicationId,revision])
}
model WorkTransfer {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId],references:[id])
  attemptId String
  attempt ProjectAttempt @relation(fields:[attemptId],references:[id])
  revision Int
  snapshot Json
  consentAt DateTime @default(now())
  @@unique([applicationId,attemptId,revision])
}
model Material {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  applicationId String?
  application Application? @relation(fields:[applicationId],references:[id])
  name String
  mime String
  size Int
  kind String
  bytes Bytes
  createdAt DateTime @default(now())
  sources Source[]
  sha256 String?
  durationMs Int?
}
model Episode {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId],references:[id])
  title String
  personalRole String
  sources Source[]
  annotations EpisodeAnnotation[]
  mergedIntoId String?
  mergedAt DateTime?
  mergedBy String?
  mergeReason String?
}
model Source {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId],references:[id])
  episodeId String?
  episode Episode? @relation(fields:[episodeId],references:[id])
  materialId String?
  material Material? @relation(fields:[materialId],references:[id])
  title String
  kind String
  content String
  provenance String @default("CANDIDATE_ACCOUNT")
  createdAt DateTime @default(now())
  corrections Correction[]
  messageId String? @unique
  views SourceView[]
  annotations EpisodeAnnotation[]
}
model Correction {
  id String @id @default(cuid())
  sourceId String
  source Source @relation(fields:[sourceId],references:[id])
  authorId String
  explanation String
  createdAt DateTime @default(now())
}
model Assessment {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId],references:[id])
  authorId String
  author User @relation(fields:[authorId],references:[id])
  domain String
  level String
  sufficiency String
  contradiction String
  interpretation String
  sourceIds String[]
  rubricVersion Int @default(1)
  materialVersion String?
  reviewedSnapshot Json?
  createdAt DateTime @default(now())
}
model Decision {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId],references:[id])
  authorId String
  author User @relation(fields:[authorId],references:[id])
  action String
  reason String
  fromStage String
  toStage String
  materialVersion String?
  reviewedSnapshot Json?
  feedback FeedbackPublication[]
  createdAt DateTime @default(now())
}
model Message {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId],references:[id])
  authorId String
  author User @relation(fields:[authorId],references:[id])
  body String
  kind String @default("MESSAGE")
  createdAt DateTime @default(now())
}
model Interview {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId],references:[id])
  scheduledAt DateTime
  status String @default("SCHEDULED")
  notes Json
  revision Int @default(0)
  revisions InterviewVersion[]
  plan Json?
  result Json?
  performedAt DateTime?
  completedBy String?
  materialVersion String?
}
model InterviewVersion {
  id String @id @default(cuid())
  interviewId String
  interview Interview @relation(fields:[interviewId],references:[id])
  authorId String
  notes Json
  revision Int
  kind String @default("LEGACY")
  materialVersion String?
  createdAt DateTime @default(now())
  @@unique([interviewId,revision])
}
model LanguageCheck {
  id String @id @default(cuid())
  applicationId String @unique
  application Application @relation(fields:[applicationId],references:[id])
  state Json
  revision Int @default(0)
  status String @default("IN_PROGRESS")
  result String @default("Ожидает ответа")
  reviewerId String?
  reviewedAt DateTime?
  history LanguageVersion[]
  audioJobs AudioJob[]
}

model AudioConsent {
  applicationId String @id
  application Application @relation(fields:[applicationId],references:[id],onDelete:Cascade)
  version String
  revision Int @default(1)
  granted Boolean
  updatedAt DateTime @updatedAt
}
model AudioConsentEvent {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId],references:[id],onDelete:Cascade)
  actorId String
  version String
  revision Int
  granted Boolean
  text String
  createdAt DateTime @default(now())
  @@unique([applicationId,revision])
}
model AudioJob {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId],references:[id],onDelete:Cascade)
  checkId String
  check LanguageCheck @relation(fields:[checkId],references:[id],onDelete:Cascade)
  identity String @unique
  mode String @default("LIVE")
  oralId String
  followupId String
  oralHash String
  followupHash String
  taskVersion String
  taskSnapshot Json
  instructionVersion String
  consentRevision Int
  provider String @default("openai")
  transcriptionModel String
  textModel String
  status String @default("QUEUED")
  attempts Int @default(0)
  nextRunAt DateTime @default(now())
  leaseToken String?
  leaseUntil DateTime?
  errorCode String?
  summary Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  transcripts AudioTranscript[]
  calls AudioProviderCall[]
  reviews AudioReview[]
  @@index([mode,status,nextRunAt])
  @@index([applicationId,createdAt])
}
model AudioTranscript {
  id String @id @default(cuid())
  jobId String
  job AudioJob @relation(fields:[jobId],references:[id],onDelete:Cascade)
  materialId String
  kind String
  text String
  version Int @default(0)
  createdAt DateTime @default(now())
  corrections AudioTranscriptCorrection[]
  @@unique([jobId,kind])
}
model AudioTranscriptCorrection {
  id String @id @default(cuid())
  transcriptId String
  transcript AudioTranscript @relation(fields:[transcriptId],references:[id],onDelete:Cascade)
  authorId String
  version Int
  text String
  reason String
  createdAt DateTime @default(now())
  @@unique([transcriptId,version])
}
model AudioProviderCall {
  id String @id @default(cuid())
  jobId String
  job AudioJob @relation(fields:[jobId],references:[id],onDelete:Cascade)
  step String
  status String @default("STARTED")
  requestId String?
  responseId String?
  model String
  usage Json?
  errorCode String?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  @@index([createdAt])
}
model AudioReview {
  id String @id @default(cuid())
  jobId String
  job AudioJob @relation(fields:[jobId],references:[id],onDelete:Cascade)
  authorId String
  languageRevision Int
  transcriptVersions Json
  rejectedIds String[]
  note String
  conclusion String
  createdAt DateTime @default(now())
}
model LanguageVersion {
  id String @id @default(cuid())
  checkId String
  check LanguageCheck @relation(fields:[checkId],references:[id])
  revision Int
  state Json
  authorId String
  createdAt DateTime @default(now())
  @@unique([checkId,revision])
}
model Setting {
  key String @id
  value Json
  updatedAt DateTime @updatedAt
}

model ScoringRun {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  context String @default("OFFICIAL")
  auditId String?
  audit TwinAudit? @relation(fields:[auditId], references:[id], onDelete:Cascade)
  variant String?
  identity String @unique
  inputHash String
  materialVersion String
  criteriaVersion String
  provider String
  scenarioVersion String
  input Json
  result Json?
  status String @default("QUEUED")
  requestedBy String
  leaseToken String?
  leaseUntil DateTime?
  errorCode String?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  completedAt DateTime?
  reviews ScoringReview[]
  @@index([applicationId, createdAt])
  @@unique([auditId, variant])
}

model TwinAudit {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  caseKey String
  caseVersion String
  baseInputHash String
  definition Json
  definitionHash String
  comparison Json?
  comparisonVersion String
  requestKey String @unique
  requestedBy String
  createdAt DateTime @default(now())
  runs ScoringRun[]
  reviews TwinReview[]
  @@index([applicationId, createdAt])
}
model TwinReview {
  id String @id @default(cuid())
  auditId String
  audit TwinAudit @relation(fields:[auditId], references:[id], onDelete:Cascade)
  authorId String
  author User @relation(fields:[authorId], references:[id])
  verdict String
  note String
  viewedVersions Json
  requestKey String @unique
  createdAt DateTime @default(now())
}

model ScoringReview {
  id String @id @default(cuid())
  runId String
  run ScoringRun @relation(fields:[runId], references:[id], onDelete:Cascade)
  authorId String
  author User @relation(fields:[authorId], references:[id])
  requestKey String @unique
  result Json
  rejectedEvidenceIds String[]
  reason String
  createdAt DateTime @default(now())
}

// Developer-only fixtures: no application-facing write API.
model ScoringFixture {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  inputHash String
  scenarioVersion String
  result Json
  createdAt DateTime @default(now())
  @@unique([applicationId, inputHash])
}
model RateLimit {
  key String @id
  count Int @default(1)
  resetAt DateTime
}

model DomainReview {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId],references:[id],onDelete:Cascade)
  authorId String
  domain String
  sourceIds String[]
  sufficiency String
  consistency String
  question String
  gap String
  observation String
  materialVersion String
  reviewedSnapshot Json
  createdAt DateTime @default(now())
  @@index([applicationId,domain,createdAt])
}
model SourceView {
  id String @id @default(cuid())
  sourceId String
  source Source @relation(fields:[sourceId],references:[id],onDelete:Cascade)
  authorId String
  correctionIds String[]
  createdAt DateTime @default(now())
  @@index([sourceId,createdAt])
}
model EpisodeAnnotation {
  id String @id @default(cuid())
  episodeId String
  episode Episode @relation(fields:[episodeId],references:[id],onDelete:Cascade)
  sourceId String
  source Source @relation(fields:[sourceId],references:[id],onDelete:Cascade)
  authorId String
  quote String
  personalAction String
  createdAt DateTime @default(now())
}
model FeedbackPublication {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId],references:[id],onDelete:Cascade)
  decisionId String
  decision Decision @relation(fields:[decisionId],references:[id],onDelete:Cascade)
  authorId String
  observation String
  suggestion String
  nextAction String
  sourceIds String[]
  materialVersion String
  reviewedSnapshot Json
  previewedBy String?
  previewedAt DateTime?
  publishedBy String?
  publishedAt DateTime?
  messageId String? @unique
  createdAt DateTime @default(now())
  @@index([applicationId,createdAt])
}
