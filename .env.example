DATABASE_URL="postgresql://leader@127.0.0.1:55439/leader_id?schema=public"
APP_ORIGIN="http://localhost:3000"
COOKIE_SECURE="false"
ENABLE_LOCAL_SEED="true"

# Server-only; never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=""
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe-2025-12-15"
OPENAI_TEXT_MODEL="gpt-4.1-mini-2025-04-14"
# The Node application process polls PostgreSQL. No external queue is required.
AUDIO_WORKER_ENABLED="true"
# Upper bound on reserved external calls in a rolling 24-hour period.
AUDIO_DAILY_REQUEST_LIMIT="30"
