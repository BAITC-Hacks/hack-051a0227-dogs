DATABASE_URL="postgresql://leader@127.0.0.1:55439/leader_id?schema=public"
APP_ORIGIN="http://localhost:3000"
COOKIE_SECURE="false"
ENABLE_LOCAL_SEED="false"

# Explicit server selection. API keys never change the assessment adapter.
ASSESSMENT_PROVIDER="local"
# Profile explanations are a separate operation and never trigger scoring.
PROFILE_PROVIDER="local"
# Prepared fictional results require isolated-local AND ASSESSMENT_QA origin.
# Keep standard for any environment holding real applications.
ASSESSMENT_ENVIRONMENT="standard"

# OpenAI key, task models and audio processing are configured by the owner at
# /settings/openai. OPENAI_API_KEY and the old model/worker env switches are ignored.
# Secondary abuse cap; monetary limits are configured in the browser.
AUDIO_DAILY_REQUEST_LIMIT="30"
