# Copy to .env.production and replace both password values with the same strong,
# URL-encoded value. Keep this file outside Git and restrict it to the operator.
POSTGRES_PASSWORD=replace-with-long-random-url-safe-value
DATABASE_URL=postgresql://invision:replace-with-long-random-url-safe-value@db:5432/invision?schema=public
APP_ORIGIN=https://your-domain.example
APP_DOMAIN=your-domain.example
COOKIE_SECURE=true
ENABLE_LOCAL_SEED=false
ASSESSMENT_ENVIRONMENT=standard
ASSESSMENT_PROVIDER=local
PROFILE_PROVIDER=local
INTAKE_WORKER_DISABLED=false
AUDIO_DAILY_REQUEST_LIMIT=30
# Optional server-side OAuth credentials; leave unset until configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
